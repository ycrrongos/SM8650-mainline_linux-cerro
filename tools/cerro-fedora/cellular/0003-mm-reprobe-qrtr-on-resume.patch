 /*****************************************************************************/

+void
+mm_base_manager_resume (MMBaseManager *self)
+{
+    /* Full suspend cancels the old authentication requests and removes
+     * device objects, but the QRTR watcher keeps its live nodes. */
+    g_clear_object (&self->priv->authp_cancellable);
+    self->priv->authp_cancellable = g_cancellable_new ();
+
+    mm_base_manager_start (self, FALSE);
+#if defined WITH_QRTR
+    if (self->priv->auto_scan && self->priv->qrtr_bus_watcher)
+        mm_qrtr_bus_watcher_replay_devices (self->priv->qrtr_bus_watcher);
+#endif
+}
