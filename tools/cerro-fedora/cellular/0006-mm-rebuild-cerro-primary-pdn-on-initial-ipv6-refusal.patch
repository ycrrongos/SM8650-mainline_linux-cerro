 /*****************************************************************************/
 
 static void
+cerro_reconnect_ready (MMBaseBearer *self,
+                       GAsyncResult *res,
+                       GTask        *task)
+{
+    GError *error = NULL;
+    MMBearerConnectResult *result;
+
+    result = connect_finish (self, res, &error);
+    if (result)
+        g_task_return_pointer (task, result, (GDestroyNotify)mm_bearer_connect_result_unref);
+    else
+        g_task_return_error (task, error);
+    g_object_unref (task);
+}
+
+static void
+cerro_disconnect_for_retry_ready (MMBaseBearer *self,
+                                  GAsyncResult *res,
+                                  GTask        *task)
+{
+    MMBearerQmi *qmi = MM_BEARER_QMI (self);
+    GError *error = NULL;
+
+    qmi->priv->cerro_rebuilding_pdn = FALSE;
+    if (!disconnect_finish (self, res, &error)) {
+        if (qmi->priv->packet_data_handle_ipv4) {
+            mm_obj_warn (self, "couldn't stop the initial IPv4 PDN: %s", error->message);
+            g_clear_error (&error);
+            g_task_return_pointer (task,
+                                   mm_bearer_connect_result_ref (g_task_get_task_data (task)),
+                                   (GDestroyNotify)mm_bearer_connect_result_unref);
+        } else
+            g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (g_task_return_error_if_cancelled (task)) {
+        g_object_unref (task);
+        return;
+    }
+
+    _connect (self, g_task_get_cancellable (task),
+              (GAsyncReadyCallback)cerro_reconnect_ready, task);
+}
+
+static void
+cerro_first_connect_ready (MMBaseBearer *self,
+                           GAsyncResult *res,
+                           GTask        *task)
+{
+    ConnectContext *ctx = g_task_get_task_data (G_TASK (res));
+    MMBearerConnectResult *result;
+    GError *error = NULL;
+
+    result = connect_finish (self, res, &error);
+    if (!result) {
+        g_task_return_error (task, error);
+        g_object_unref (task);
+        return;
+    }
+
+    if (ctx->cerro_data_subscription == CERRO_SUBSCRIPTION_PRIMARY &&
+        ctx->ipv4 && ctx->ipv6 && ctx->ipv4_config && !ctx->ipv6_config &&
+        ctx->cerro_ipv6_pdn_refused && !g_cancellable_is_cancelled (g_task_get_cancellable (task))) {
+        /* A new IPv6 client alone inherits the initial IPv4-only PDN.
+         * Release it through the ordinary disconnect path before retrying. */
+        mm_obj_msg (self, "rebuilding the primary PDN once after an IPv4-only first connection");
+        g_task_set_task_data (task, result, (GDestroyNotify)mm_bearer_connect_result_unref);
+        /* Keep IPv4 monitoring if the modem refuses the stop request. */
+        MM_BEARER_QMI (self)->priv->cerro_rebuilding_pdn = TRUE;
+        disconnect (self, (GAsyncReadyCallback)cerro_disconnect_for_retry_ready, task);
+        return;
+    }
+
+    g_task_return_pointer (task, result, (GDestroyNotify)mm_bearer_connect_result_unref);
+    g_object_unref (task);
+}
+
+static void
+connect_with_cerro_pdn_rebuild (MMBaseBearer        *self,
+                                GCancellable        *cancellable,
+                                GAsyncReadyCallback  callback,
+                                gpointer             user_data)
+{
+    GTask *task;
+
+    if (g_strcmp0 (g_getenv ("MM_CERRO_QMI_DDS"), "1") != 0) {
+        _connect (self, cancellable, callback, user_data);
+        return;
+    }
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    g_task_set_check_cancellable (task, FALSE);
+    _connect (self, cancellable, (GAsyncReadyCallback)cerro_first_connect_ready, task);
+}
