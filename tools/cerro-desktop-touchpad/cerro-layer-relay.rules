// Only the local, active Cerro desktop owner can start the fixed input relay.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "cerro-layer-relay.service" &&
        action.lookup("verb") === "start" &&
        subject.local && subject.active && subject.user === "rong") {
        return polkit.Result.YES;
    }
});
