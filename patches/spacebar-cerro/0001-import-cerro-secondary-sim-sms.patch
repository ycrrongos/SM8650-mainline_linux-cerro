+static QJsonArray readCerroMessages()
+{
+    const auto path = SL("/run/cerro-cellular/control.sock");
+    if (!QFileInfo::exists(path)) {
+        return {};
+    }
+
+    QLocalSocket socket;
+    socket.connectToServer(path);
+    if (!socket.waitForConnected(1000)) {
+        return {};
+    }
+    socket.write("{\"action\":\"messages\"}\n");
+    if (socket.bytesToWrite() && !socket.waitForBytesWritten(1000)) {
+        return {};
+    }
+
+    QDeadlineTimer deadline(8000);
+    QByteArray response;
+    while (!response.endsWith('\n')) {
+        if (!socket.bytesAvailable() && !socket.waitForReadyRead(deadline.remainingTime())) {
+            return {};
+        }
+        response += socket.readAll();
+        if (response.size() > 1024 * 1024 || deadline.hasExpired()) {
+            return {};
+        }
+    }
+
+    const auto reply = QJsonDocument::fromJson(response).object();
+    return reply.value(SL("ok")).toBool() ? reply.value(SL("result")).toArray() : QJsonArray{};
+}
