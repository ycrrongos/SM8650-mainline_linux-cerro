@@ -72,4 +114,58 @@ ChannelLogger::ChannelLogger(std::optional<QString> &modemPath, QObject *parent)
     // Check for any unhandled messages from the modem
     checkMessages();
+
+    // The stock ModemManager modem represents Cerro's first subscription.
+    auto *cerroSmsTimer = new QTimer(this);
+    connect(cerroSmsTimer, &QTimer::timeout, this, [this] { importCerroMessages(); });
+    cerroSmsTimer->start(10000);
+    importCerroMessages();
+}
+
+QCoro::Task<void> ChannelLogger::importCerroMessages()
+{
+    if (m_importingCerroMessages) {
+        co_return;
+    }
+    QScopedValueRollback importing(m_importingCerroMessages, true);
+    const auto rows = co_await QtConcurrent::run(readCerroMessages);
+    QSettings imported(SL("cerro"), SL("spacebar-sms-import"));
+    for (const auto &entry : rows) {
+        const auto row = entry.toObject();
+        if (row.value(SL("slot")).toInt() != 2 || row.value(SL("direction")).toString() != SL("in")) {
+            continue;
+        }
+
+        const auto sourceId = row.value(SL("id")).toString();
+        const auto sender = row.value(SL("number")).toString();
+        const auto text = row.value(SL("text")).toString();
+        const auto time = row.value(SL("time")).toInteger();
+        if (sourceId.isEmpty() || sender.isEmpty() || text.isEmpty() || time <= 0 || (text.endsWith(u'）') && text.contains(SL("\n（已收到 ")))) {
+            continue;
+        }
+
+        const auto identity = QJsonDocument(QJsonArray{sourceId, sender, time, text}).toJson(QJsonDocument::Compact);
+        const auto key = QString::fromLatin1(QCryptographicHash::hash(identity, QCryptographicHash::Sha256).toHex());
+        if (imported.contains(key)) {
+            continue;
+        }
+
+        Message message{};
+        message.id = SL("cerro-") + key;
+        message.phoneNumberList = PhoneNumberList(sender);
+        message.datetime = QDateTime::fromSecsSinceEpoch(time);
+        message.text = text;
+        message.deliveryStatus = MessageState::Received;
+        message.read = message.phoneNumberList == m_disabledNotificationNumber;
+        if ((co_await m_database.messagesForNumber(message.phoneNumberList, message.id)).empty()) {
+            co_await addMessage(message);
+            if ((co_await m_database.messagesForNumber(message.phoneNumberList, message.id)).empty()) {
+                continue;
+            }
+            if (!message.read) {
+                createNotification(message);
+            }
+        }
+        imported.setValue(key, true);
+    }
 }

